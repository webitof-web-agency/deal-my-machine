APP_NAME=DealMyMachine
SITE_URL=https://dealmymachine.com
FRONTEND_URL=https://dealmymachine.com
ADMIN_PORTAL_URL=https://admin.dealmymachine.com
SUPPORT_EMAIL=hello@dealmymachine.com
ADMIN_EMAIL_FALLBACK=hello@dealmymachine.com
APPLICATION_REFERENCE_PREFIX=DMM-JOB
DATABASE_URL=postgresql://user:password@localhost:5432/database
PORT=5002
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://dealmymachine.com,https://www.dealmymachine.com,https://admin.dealmymachine.com
VAPID_SUBJECT=mailto:hello@dealmymachine.com
# Optional: use the deployed backend URL for the keep-alive ping.
# RENDER_EXTERNAL_URL=https://api.dealmymachine.com
APP_STORAGE_DIR=/var/lib/dealmymachine
APP_RUNTIME_STORAGE_DIR=/var/lib/dealmymachine
JWT_SECRET=replace-with-a-long-random-secret
# Used to encrypt Google Drive OAuth secrets in runtime settings/database.
APP_SETTINGS_ENCRYPTION_KEY=replace-with-a-second-long-random-secret
# Keep enabled on the backend host to run the daily 3:00 AM IST PostgreSQL backup.
DATABASE_BACKUP_ENABLED=true
# PostgreSQL client executable used by the backup job. Set an absolute path if it is not on PATH.
PG_DUMP_PATH=pg_dump
